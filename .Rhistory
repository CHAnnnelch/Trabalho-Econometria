install.packages("lmtest")
library(stats)
library(lmtest)
library(corrplot)
library(car)
library(dplyr)
#testes
dwtest(modelo)
bptest(modelo)
vif(modelo)
#qqnorm e qqline
qqnorm(modelo$residuals)
qqline(modelo$residuals)
