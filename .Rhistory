summary(modelo)
#R2 ajustado de 0.9291
confint(modelo, level=0.95)
modelo <- lm(CPIscore ~ scofree + stability + propr + govint + taxb + govspend + g_GDP + busfree + labfree + monfree + tradfree + investfree + finfree, data=df)
